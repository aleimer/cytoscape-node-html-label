{
  "name": "cytoscape-node-html-label",
  "version": "1.2.2",
  "description": "labels for cytoscape nodes",
  "author": "Kalugin Sergey <kalugin.perm@gmail.com> (https://github.com/kaluginserg)",
  "main": "./dist/cytoscape-node-html-label.js",
  "spm": {
    "main": "./dist/cytoscape-node-html-label.js"
  },
  "scripts": {
    "start": "tsc --watch --declaration",
    "build": "tsc --declaration && terser dist/cytoscape-node-html-label.js -c -m -o dist/cytoscape-node-html-label.min.js",
    "lint": "eslint src --ext .ts",
    "test": "karma start karma.conf.js",
    "test-firefox": "karma start karma.conf.js --browsers Firefox",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaluginserg/cytoscape-node-html-label.git"
  },
  "keywords": [
    "cytoscape",
    "cytoscape-extension",
    "cytoscape-labels",
    "cytoscape html label"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kaluginserg/cytoscape-node-html-label/issues"
  },
  "homepage": "https://github.com/kaluginserg/cytoscape-node-html-label",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cytoscape": "^3.33.1",
    "eslint": "^8.57.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "terser": "^5.31.6",
    "typescript": "~5.5.4"
  },
  "peerDependencies": {
    "@types/cytoscape": "^3.1.0",
    "cytoscape": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@types/cytoscape": {
      "optional": true
    }
  },
  "dependencies": {}
}
